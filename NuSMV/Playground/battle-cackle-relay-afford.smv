MODULE main

DEFINE
  MAX_POS   := 9;      -- grid indices 0..9
  STEPS     := 5;      -- total number of moves per leg
  R         := 3;      -- maximum reachable radius (Euclidean distance)
  BUSY_CELL1_X := 6;   --(example: cell (3,3) and cell (8,2) are busy)
  BUSY_CELL1_Y := 6;
  BUSY_CELL2_X := 8;
  BUSY_CELL2_Y := 2;

VAR
  -- robot leg positions and the step counter
  step : 0..STEPS;
  leg1_x : 0..MAX_POS;  -- leg 1 coordinates
  leg1_y : 0..MAX_POS; 
  leg2_x : 0..MAX_POS;  -- leg 2 coordinates
  leg2_y : 0..MAX_POS;
  
  err_reachable : boolean;  -- error if move is too far
  err_collision      : boolean;  -- error if target cell is busy

  -- In this model the planned move for each leg is “looked up”
  -- from the current step. (At step 0, we plan the move that leads to step 1, etc.)
DEFINE
  -- Planned target positions for the leg 1:
  -- (2,2) -> (3,2) -> (3,3) -> (4,3) -> (4,4)
  planned_leg1_x := case
        step = 0 : 2;
        step = 1 : 3;
        step = 2 : 3;
        step = 3 : 4;
        step = 4 : 4;
        TRUE     : leg1_x;  -- at step = 5 no further move
  esac;

  planned_leg1_y := case
        step = 0 : 2;
        step = 1 : 2;
        step = 2 : 3;
        step = 3 : 3;
        step = 4 : 4;
        TRUE     : leg1_y;
  esac;

  -- Planned target positions for the leg 2:
  -- (1,2) -> (1,3) -> (2,3) -> (2,4) -> (3,4)
  planned_leg2_x := case
        step = 0 : 1;
        step = 1 : 1;
        step = 2 : 2;
        step = 3 : 2;
        step = 4 : 3;
        TRUE     : leg2_x;
  esac;

  planned_leg2_y := case
        step = 0 : 2;
        step = 1 : 3;
        step = 2 : 3;
        step = 3 : 4;
        step = 4 : 4;
        TRUE     : leg2_y;
  esac;

  -- Busy cells check
  busy_planned_1 :=   ((planned_leg1_x = BUSY_CELL1_X) & (planned_leg1_y = BUSY_CELL1_Y))
                    | ((planned_leg1_x = BUSY_CELL2_X) & (planned_leg1_y = BUSY_CELL2_Y));
  busy_planned_2 :=   ((planned_leg2_x = BUSY_CELL1_X) & (planned_leg2_y = BUSY_CELL1_X))
                    | ((planned_leg2_x = BUSY_CELL2_X) & (planned_leg2_y = BUSY_CELL2_Y));

  -- Compute differences
  dx1 := planned_leg1_x - leg1_x;
  dy1 := planned_leg1_y - leg1_y;
  dx2 := planned_leg2_x - leg2_x;
  dy2 := planned_leg2_y - leg2_y;

  -- Define separately the reachability and cell-free conditions:
  reachable_1  := (dx1*dx1 + dy1*dy1) <= R*R;
  reachable_2  := (dx2*dx2 + dy2*dy2) <= R*R;
  free_1       := !busy_planned_1;
  free_2      := !busy_planned_2;

ASSIGN
  -- initial states
  init(step)  := 0;
  init(leg1_x)   := 0;
  init(leg1_y)   := 0;
  init(leg2_x)   := 1;
  init(leg2_y)   := 0;
  init(err_collision)   := FALSE;
  init(err_reachable)   := FALSE;


  -- State transitions:
  -- At each step (if step < STEPS) the legs move to the planned cell.
  next(step) :=
    case
      step < STEPS : step + 1;
      TRUE         : step;
    esac;

  next(leg1_x) :=
    case
      step < STEPS : planned_leg1_x;
      TRUE         : leg1_x;
    esac;

  next(leg1_y) :=
    case
      step < STEPS : planned_leg1_y;
      TRUE         : leg1_y;
    esac;

  next(leg2_x) :=
    case
      step < STEPS : planned_leg2_x;
      TRUE         : leg2_x;
    esac;

  next(leg2_y) :=
    case
      step < STEPS : planned_leg2_y;
      TRUE         : leg2_y;
    esac;

  -- Update error flags separately:
  next(err_reachable) :=
    err_reachable | (step < STEPS & (!reachable_1 | !reachable_2));

  next(err_collision) :=
    err_collision | (step < STEPS & (!free_1 | !free_2));


-- TODO define feasibility without collisions 
-- LTLSPEC
--   G (! err_reachable);

-- LTLSPEC
--   G (! err_collision);
