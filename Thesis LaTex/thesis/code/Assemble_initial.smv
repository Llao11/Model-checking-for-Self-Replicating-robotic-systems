MODULE main
  DEFINE
    field_max_index := 5;
    robot_size := 5;
    initial_grid := [
    [NONE,NONE,NONE,NONE,NONE,NONE],
    [NONE,NONE,TYPE2,NONE,NONE,NONE],
    [TYPE2,NONE,NONE,NONE,NONE,NONE],
    [NONE,TYPE3,NONE,TYPE1,NONE,NONE],
    [TYPE3,NONE,NONE,TYPE3,NONE,NONE],
    [NONE,NONE,NONE,NONE,NONE,NONE]
    ];
  VAR 
    grid : array 0..field_max_index of array 0..field_max_index of  {TYPE1, TYPE2, NONE, TYPE3, OBSTACLE1}; 
    checked_cells : array 0..field_max_index of array 0..field_max_index of {UNKNOWN, VISITED}; 
    x : 0..field_max_index; -- horizontal axis
    y : 0..field_max_index; -- vertical axis
    robot_state : {MOVING, CHECKING, ASSEMBLING, FINISHED, FAILED };
    partX : 0..field_max_index;
    partY : 0..field_max_index;
    assembly_index : 0..robot_size;
    sequence : array 0..robot_size of  {TYPE3, TYPE1, TYPE2};
  ASSIGN
    init(robot_state) := MOVING;      -- start in MOVING mode
    init(x) := 0; init(y) := 0;          -- start at position (0,0) (assembly site for example)
    init(assembly_index) := 0;           -- no parts FINISHED initially
    init(grid) := initial_grid;
     init(sequence[0]) := TYPE1;
     init(sequence[1]) := TYPE2;
     init(sequence[2]) := TYPE3;
     init(sequence[3]) := TYPE3;
     init(sequence[4]) := TYPE2;
     init(sequence[5]) := TYPE3;
    next(robot_state) := case
      (robot_state = MOVING & 
      (assembly_index <= robot_size) & 
      ((x = 0                 | grid[x - 1][y] != NONE ) & 
        (x = field_max_index  | grid[x + 1][y] != NONE) & 
        (y = 0                | grid[x][y - 1] != NONE ) & 
        (y = field_max_index  | grid[x][y + 1] != NONE ))
      ) : FAILED;
      (robot_state = MOVING & 
       ((x > 0                & grid[x - 1][y] != NONE) | 
        (x < field_max_index  & grid[x + 1][y] != NONE) | 
        (y > 0                & grid[x][y - 1] != NONE) | 
        (y < field_max_index  & grid[x][y + 1] != NONE))
      ) : CHECKING;
      (robot_state = CHECKING & 
      assembly_index <= robot_size
      ) : case
            grid[partX][partY]  = sequence[assembly_index] : ASSEMBLING; -- if part is needed type, go to ASSEMBLING (to pick it up, transport to assemble site and assemble)
            grid[partX][partY] != sequence[assembly_index] : MOVING; -- if part is not needed, go back to MOVING (continue looking)
          esac;
      (robot_state = ASSEMBLING
      ) : case 
            assembly_index < robot_size : MOVING;
            assembly_index = robot_size : FINISHED;
          esac;
      robot_state = FINISHED  : FINISHED;
      robot_state = FAILED    : FAILED;
      TRUE : robot_state;  -- default: no change (should not happen under normal conditions)
    esac;
    next(assembly_index) := case
      (robot_state = ASSEMBLING & 
      (assembly_index < robot_size)
      ): assembly_index + 1;   -- delivered a part, count it
      TRUE : assembly_index;
    esac;
    next(partX) := case
      (
        robot_state = MOVING & next(robot_state) = CHECKING & 
        x > 0 & grid[x - 1][y] = sequence[assembly_index]
      ) : x - 1;  -- found in left neighbour cell
      (
        robot_state = MOVING & next(robot_state) = CHECKING & 
        x < field_max_index & grid[x + 1][y] = sequence[assembly_index]
      ) : x + 1;  -- found in right neighbour cell
      TRUE : x;  -- otherwise, retain previous (or irrelevant outside checking context)
    esac;
    next(partY) := case
      (
        robot_state = MOVING & next(robot_state) = CHECKING & 
        y > 0 & grid[x][y - 1] = sequence[assembly_index]
      ) : y - 1;  -- found in upper neighbour cell

      (
        robot_state = MOVING & next(robot_state) = CHECKING & 
        y < field_max_index & grid[x][y + 1] = sequence[assembly_index]
      ) : y + 1;  -- found in down neighbour cell

      TRUE : y;
    esac;
  TRANS 
    (next(robot_state) = MOVING ) -> (   
                                    (
                                      next(x) = x - 1 & x > 0  
                                      & next(y) = y 
                                      & grid[x - 1][y] = NONE
                                      & checked_cells[x - 1][y] != VISITED
                                    ) |
                                  (
                                    next(x) = x + 1 & x < field_max_index  
                                    & next(y) = y 
                                    & grid[x + 1][y] = NONE
                                    & checked_cells[x + 1][y] != VISITED 
                                  )|
                                  (next(y) = y - 1 & y > 0 
                                    & next(x) = x 
                                    & grid[x][y - 1] = NONE
                                    & checked_cells[x][y - 1] != VISITED
                                  ) |
                                  (
                                    next(y) = y + 1 & y < field_max_index  
                                    & next(x) = x 
                                    & grid[x][y + 1] = NONE
                                    & checked_cells[x][y + 1] != VISITED 
                                  ) 
                                  );

  TRANS
  (next(robot_state) != MOVING) -> ((next(x) = x) & (next(y) = y));
  TRANS  (next(grid) = grid);
  TRANS  (next(sequence) = sequence);
  TRANS  (robot_state != ASSEMBLING) -> (next(assembly_index) = assembly_index);

LTLSPEC
  G F (robot_state != FINISHED);
