MODULE sin(angle)
DEFINE
    val:= case
    angle = 0  :   0;  	angle = 1  :  17; 	angle = 2  :  34;
    angle = 3  : 50; 	angle = 4  :  64; 	angle = 5  :  77;
    angle = 6  :  87; 	angle = 7  : 94; 	angle = 8  :  98;
    angle = 9  : 100; 	angle = 10 :  98; 	angle = 11 : 94;
    angle = 12 :  87; 	angle = 13 :  77; 	angle = 14 :  64;
    angle = 15 : 50; 	angle = 16 :  34; 	angle = 17 :  17;
    angle = 18 :   0; 	angle = 19 :-17; 	angle = 20 :-34;
    angle = 21 :-50; 	angle = 22 :-64; 	angle = 23 :-77;
    angle = 24 :-87; 	angle = 25 :-94; 	angle = 26 :-98;
    angle = 27 :-100; 	angle = 28 :-98; 	angle = 29 :-94;
    angle = 30 :-87; 	angle = 31 :-77; 	angle = 32 :-64;
    angle = 33 :-50; 	angle = 34 :-34; 	angle = 35 :-17;
    TRUE : 0;
    esac;

MODULE cos(angle)
DEFINE
    val:= case
    angle = 0  : 100; 	angle = 1  :  98; 	angle = 2  :  94;
    angle = 3  : 87; 	angle = 4  :  77; 	angle = 5  :  64;
    angle = 6  :  50; 	angle = 7  : 34; 	angle = 8  :  17;
    angle = 9  :   0; 	angle = 10 :-17; 	angle = 11 :-34;
    angle = 12 :-50; 	angle = 13 :-64; 	angle = 14 :-77;
    angle = 15 :-87; 	angle = 16 :-94; 	angle = 17 :-98;
    angle = 18 :-100; 	angle = 19 :-98; 	angle = 20 :-94;
    angle = 21 :-87; 	angle = 22 :-77; 	angle = 23 :-64;
    angle = 24 :-50; 	angle = 25 :-34; 	angle = 26 :-17;
    angle = 27 :   0; 	angle = 28 :  17; 	angle = 29 :  34;
    angle = 30 :  50; 	angle = 31 : 64; 	angle = 32 :  77;
    angle = 33 :  87; 	angle = 34 :  94; 	angle = 35 : 98;
    TRUE : 0;
    esac;

--=========================================
MODULE block_base(px, py, pz, xhx, xhy, xhz, yhx, yhy, yhz, zhx, zhy, zhz, L)
DEFINE
  xhx2 := xhx;
  xhy2 := xhx;
  xhz2 := xhz;

  yhx2 := yhx;
  yhy2 := yhx;
  yhz2 := yhz;

  zhx2 := zhx;
  zhy2 := zhy;
  zhz2 := zhz;

  px2 := px;
  py2 := py;
  pz2 := pz;

--=========================================
MODULE block_yaw(px, py, pz,
                   xhx, xhy, xhz, yhx, yhy, yhz, zhx, zhy, zhz,
                   L, initYaw)
VAR
  yaw : 0..35;
  cy : cos(yaw);
  sy : sin(yaw);

DEFINE
  SCALE := 100;

  cos_yaw := cy.val;    -- [-100..100]
  sin_yaw := sy.val;

  xhx2 := (xhx * cos_yaw - xhy * sin_yaw) / SCALE;
  xhy2 := (xhx * sin_yaw + xhy * cos_yaw) / SCALE;
  xhz2 := xhz;

  yhx2 := (yhx * cos_yaw - yhy * sin_yaw) / SCALE;
  yhy2 := (yhx * sin_yaw + yhy * cos_yaw) / SCALE;
  yhz2 := yhz;

  zhx2 := zhx;
  zhy2 := zhy;
  zhz2 := zhz;

  px2 := px + (zhx2 * L) / SCALE;
  py2 := py + (zhy2 * L) / SCALE;
  pz2 := pz + (zhz2 * L) / SCALE;


ASSIGN
  init(yaw) := initYaw;
  next(yaw) := { yaw, (yaw+1) mod 36, (yaw+35) mod 36 };



--=========================================
MODULE block_pitch(px, py, pz,
                     xhx, xhy, xhz, yhx, yhy, yhz, zhx, zhy, zhz,
                     L, initPitch)
VAR
  pitch : 0..35;

  cp : cos(pitch);
  sp : sin(pitch);

DEFINE
  SCALE := 100;

  cos_p := cp.val;    -- [-100..100]
  sin_p := sp.val;

  xhx2 := (xhx * cos_p + zhx * sin_p) / SCALE;
  xhy2 := (xhy * cos_p + zhy * sin_p) / SCALE;
  xhz2 := (xhz * cos_p + zhz * sin_p) / SCALE;

  yhx2 := yhx;  yhy2 := yhy;  yhz2 := yhz;

  zhx2 := (-xhx * sin_p + zhx * cos_p) / SCALE;
  zhy2 := (-xhy * sin_p + zhy * cos_p) / SCALE;
  zhz2 := (-xhz * sin_p + zhz * cos_p) / SCALE;

  px2 := px + (zhx2 * L) / SCALE;
  py2 := py + (zhy2 * L) / SCALE;
  pz2 := pz + (zhz2 * L) / SCALE;

ASSIGN
  init(pitch) := initPitch;
  next(pitch) := { pitch, (pitch+1) mod 36, (pitch+35) mod 36 };

--========================================
MODULE main

FROZENVAR

    checkX : -10..10;
    checkY : -10..10;
    checkZ : 0..10;
VAR
    block0 : block_base(base_px, base_py, base_pz,
                        base_xhx, base_xhy, base_xhz,
                        base_yhx, base_yhy, base_yhz,
                        base_zhx, base_zhy, base_zhz,
                        L1);
    block1 : block_yaw(block0.px, block0.py, block0.pz,
                        block0.xhx, block0.xhy, block0.xhz,
                        block0.yhx, block0.yhy, block0.yhz,
                        block0.zhx, block0.zhy, block0.zhz,
                        L1, yaw1 );
    block2 : block_pitch(block1.px2, block1.py2, block1.pz2,
                      block1.xhx2, block1.xhy2, block1.xhz2,
                      block1.yhx2, block1.yhy2, block1.yhz2,
                      block1.zhx2, block1.zhy2, block1.zhz2,
                      L2, pitch2);
    block3 : block_pitch(block2.px2, block2.py2, block2.pz2,
                      block2.xhx2, block2.xhy2, block2.xhz2,
                      block2.yhx2, block2.yhy2, block2.yhz2,
                      block2.zhx2, block2.zhy2, block2.zhz2,
                      L3, pitch3);
    block4 : block_yaw(block3.px, block3.py, block3.pz,
                        block3.xhx, block3.xhy, block3.xhz,
                        block3.yhx, block3.yhy, block3.yhz,
                        block3.zhx, block3.zhy, block3.zhz,
                        L4, yaw4 );
    block5 : block_pitch(block4.px2, block4.py2, block4.pz2,
                      block4.xhx2, block4.xhy2, block4.xhz2,
                      block4.yhx2, block4.yhy2, block4.yhz2,
                      block4.zhx2, block4.zhy2, block4.zhz2,
                      L5, pitch5);
DEFINE
    L1 := 10;   
    yaw1    := 0;
    L2 := 10;   
    pitch2  := 0;
    L3 := 10;   
    pitch3  := 0;   
    L4 := 10;   
    yaw4    := 0;
    L5 := 10;   
    pitch5  := 0;

    base_px := 0;       base_py := 0;       base_pz := 0;

    base_xhx := 100;    base_xhy := 0;      base_xhz := 0;
    base_yhx := 0;      base_yhy := 100;    base_yhz := 0;
    base_zhx := 0;      base_zhy := 0;      base_zhz := 100;

    endX := block3.px2;  
    endY := block3.py2;  
    endZ := block3.pz2;

    error := 1; -- +-1 (error=2) endX and endY coordinates error while checking reachability
    endX_inside_limits := (endX <= (checkX + error) & endX >= (checkX - error));
    endY_inside_limits := (endY <= (checkY + error) & endY >= (checkY - error));
    endZ_inside_limits := (endZ <= (checkZ + error) & endZ >= (checkZ - error));

CTLSPEC 
      EF (endX_inside_limits & endY_inside_limits & endZ_inside_limits ) --& blocks_above_serface)


