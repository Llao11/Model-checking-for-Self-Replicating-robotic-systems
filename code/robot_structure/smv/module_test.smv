

-- 1. A generic countdown timer
MODULE Timer(limit)
VAR
    t : 0..limit;          -- state variable
DEFINE
    expired := t = 0;      -- macro (combinational)
ASSIGN
    init(t) := limit;
    next(t) := case
                 t = 0 : limit;  -- restart
                 TRUE  : t - 1;
               esac;


-- 2. A single traffic light
MODULE TrafficLight(timeout)
VAR
    colour : {red, amber, green};
    timer  : Timer(timeout);    -- sub-module instance
ASSIGN
    init(colour) := red;
    next(colour) := case
                      timer.expired & colour = red   : green;
                      timer.expired & colour = green : amber;
                      timer.expired & colour = amber : red;
                      TRUE                           : colour;
                    esac;


-- 3. The system: two perpendicular lights
MODULE main
VAR
    ns : TrafficLight(5);   -- North–South, 5-tick phases
    ew : TrafficLight(5);   -- East–West
DEFINE
    safe := !(ns.colour = green & ew.colour = green);  -- macro invariant
LTLSPEC G safe
