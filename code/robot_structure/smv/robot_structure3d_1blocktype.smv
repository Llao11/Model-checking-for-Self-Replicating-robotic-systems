-- 3-D robot link with yaw and pitch (10 degrees discretisation)
-- Parameters:
--   yawVar   : VAR  0..35   ( multiples of 10°)
--   pitchVar : VAR  0..35    ( multiples of 10°)
--   LEN      : constant length
--   baseX,Y,Z: absolute parent-joint coordinates
-------------------------------------------------------------------------------

 --===== SINE Calculation========================================
MODULE sin(angle)
DEFINE
    val:= case
        angle = 0  :   0;  
        angle = 1  :  17; 
        angle = 2  :  34;
        angle = 3  : 50;
        angle = 4  :  64;
        angle = 5  :  77;
        angle = 6  :  87;
        angle = 7  : 94;
        angle = 8  :  98;
        angle = 9  : 100;
        angle = 10 :  98;
        angle = 11 : 94;
        angle = 12 :  87;
        angle = 13 :  77;
        angle = 14 :  64;
        angle = 15 : 50;
        angle = 16 :  34;
        angle = 17 :  17;
        angle = 18 :   0;
        angle = 19 :-17;
        angle = 20 :-34;
        angle = 21 :-50;
        angle = 22 :-64;
        angle = 23 :-77;
        angle = 24 :-87;
        angle = 25 :-94;
        angle = 26 :-98;
        angle = 27 :-100;
        angle = 28 :-98;
        angle = 29 :-94;
        angle = 30 :-87;
        angle = 31 :-77;
        angle = 32 :-64;
        angle = 33 :-50;
        angle = 34 :-34;
        angle = 35 :-17;
        TRUE : 0;
    esac;

 --===== COSINE Calculation========================================
MODULE cos(angle)
DEFINE
    val:= case
        angle = 0  : 100;
        angle = 1  :  98;
        angle = 2  :  94;
        angle = 3  : 87;
        angle = 4  :  77;
        angle = 5  :  64;
        angle = 6  :  50;
        angle = 7  : 34;
        angle = 8  :  17;
        angle = 9  :   0;
        angle = 10 :-17;
        angle = 11 :-34;
        angle = 12 :-50;
        angle = 13 :-64;
        angle = 14 :-77;
        angle = 15 :-87;
        angle = 16 :-94;
        angle = 17 :-98;
        angle = 18 :-100;
        angle = 19 :-98;
        angle = 20 :-94;
        angle = 21 :-87;
        angle = 22 :-77;
        angle = 23 :-64;
        angle = 24 :-50;
        angle = 25 :-34;
        angle = 26 :-17;
        angle = 27 :   0;
        angle = 28 :  17;
        angle = 29 :  34;
        angle = 30 :  50;
        angle = 31 : 64;
        angle = 32 :  77;
        angle = 33 :  87;
        angle = 34 :  94;
        angle = 35 : 98;
        TRUE : 0;
    esac;

-- ================================
-- Rotate basis by yaw (about z) then pitch (about new y)
-- Inputs:
--   xhx,xhy,xhz, yhx,yhy,yhz, zhx,zhy,zhz  -- basis components (×100)
--   psi, theta   -- angles (integers, 0..35)
-- Outputs (DEFINE):
--   xhx_new, xhy_new, xhz_new,
--   yhx_new, yhy_new, yhz_new,
--   zhx_new, zhy_new, zhz_new
-- ================================
MODULE yaw_pitch_update(xhx, xhy, xhz, yhx, yhy, yhz, zhx, zhy, zhz, yaw, pitch)
VAR
    cos_yaw_var  : cos(yaw);   
    sin_yaw_var  : sin(yaw);
    cos_pitch_var : cos(pitch); 
    sin_pitch_var : sin(pitch);

DEFINE
    SCALE := 100;
    cos_yaw     := cos_yaw_var.val;   
    sin_yaw     := sin_yaw_var.val;
    cos_pitch   := cos_pitch_var.val; 
    sin_pitch   := sin_pitch_var.val;
    -- ---------- YAW about current z ----------
    x1x := (xhx * cos_yaw - yhx * sin_yaw)/ (SCALE);
    x1y := (xhy * cos_yaw - yhy * sin_yaw)/ (SCALE);
    x1z := (xhz * cos_yaw - yhz * sin_yaw)/ (SCALE);
    y1x := (xhx * sin_yaw + yhx * cos_yaw)/ (SCALE);
    y1y := (xhy * sin_yaw + yhy * cos_yaw)/ (SCALE);
    y1z := (xhz * sin_yaw + yhz * cos_yaw)/ (SCALE);
    z1x := zhx;
    z1y := zhy;
    z1z := zhz;
    -- ---------- PITCH about the new y1 ----------
    xhx_new := (x1x * cos_pitch + z1x * sin_pitch)/ (SCALE);
    xhy_new := (x1y * cos_pitch + z1y * sin_pitch)/ (SCALE);
    xhz_new := (x1z * cos_pitch + z1z * sin_pitch)/ (SCALE);
    yhx_new := y1x;
    yhy_new := y1y;
    yhz_new := y1z;
    zhx_new := (-x1x * sin_pitch + z1x * cos_pitch)/ (SCALE);
    zhy_new := (-x1y * sin_pitch + z1y * cos_pitch)/ (SCALE);
    zhz_new := (-x1z * sin_pitch + z1z * cos_pitch)/ (SCALE);


-- ================================
-- One kinematic step from previous segment to next segment.
-- Inputs:
--   px,py,pz         -- previous tip in world units (unscaled integers)
--   xhx,xhy,xhz, yhx,yhy,yhz, zhx,zhy,zhz  -- previous basis (×100)
--   psi, theta       -- yaw/pitch for this segment (0..35)
--   L                -- segment length (world units, integer)
-- Outputs (DEFINE):
--   px2, py2, pz2    -- new tip position (world units)
--   xhx2,xhy2,xhz2, yhx2,yhy2,yhz2, zhx2,zhy2,zhz2  -- updated basis (×100)
-- ================================
MODULE next_segment(px, py, pz,
                    xhx, xhy, xhz, yhx, yhy, yhz, zhx, zhy, zhz,
                    psi, theta, L)
VAR
  upd : yaw_pitch_update(xhx, xhy, xhz, yhx, yhy, yhz, zhx, zhy, zhz, psi, theta);
DEFINE
    SCALE := 100;
  -- updated basis (exposed)
  xhx2 := upd.xhx_new;  
  xhy2 := upd.xhy_new;  
  xhz2 := upd.xhz_new;
  yhx2 := upd.yhx_new;  
  yhy2 := upd.yhy_new;  
  yhz2 := upd.yhz_new;
  zhx2 := upd.zhx_new;  
  zhy2 := upd.zhy_new;  
  zhz2 := upd.zhz_new;
  -- advance along +ẑ by length L; ẑ components are ×100
  px2 := px + (zhx2 * L) / (SCALE);
  py2 := py + (zhy2 * L) / (SCALE);
  pz2 := pz + (zhz2 * L) / (SCALE);


MODULE main

VAR
    -- joint angles (nondet. for exploration)
    yaw1 :      0..35;
    yaw2 :      0..35;
    -- yaw3 :      0..35;
    -- yaw4 :      0..35;
    pitch1 :    0..35;   -- link2
    pitch2 :    0..35;   -- link2
    -- pitch3 :    0..35;   -- link2
    -- pitch4 :    0..35;   -- link2
    
    seg1 : next_segment(base_px, base_py, base_pz,
                        base_xhx, base_xhy, base_xhz,
                        base_yhx, base_yhy, base_yhz,
                        base_zhx, base_zhy, base_zhz,
                        yaw1, pitch1, L1);

    seg2 : next_segment(seg1.px2, seg1.py2, seg1.pz2,
                      seg1.xhx2, seg1.xhy2, seg1.xhz2,
                      seg1.yhx2, seg1.yhy2, seg1.yhz2,
                      seg1.zhx2, seg1.zhy2, seg1.zhz2,
                      yaw2, pitch2, L2);
    -- seg3 : next_segment(seg2.px2, seg2.py2, seg2.pz2,
    --                   seg2.xhx2, seg2.xhy2, seg2.xhz2,
    --                   seg2.yhx2, seg2.yhy2, seg2.yhz2,
    --                   seg2.zhx2, seg2.zhy2, seg2.zhz2,
    --                  yaw3, pitch3, L3);
    --
    -- seg4 : next_segment(seg3.px2, seg3.py2, seg3.pz2,
    --                   seg3.xhx2, seg3.xhy2, seg3.xhz2,
    --                   seg3.yhx2, seg3.yhy2, seg3.yhz2,
    --                   seg3.zhx2, seg3.zhy2, seg3.zhz2,
    --                   yaw4, pitch4, L4);
DEFINE
    -- POS_MAX := 100;
    L1 := 10;   L2 := 10;    L3 := 10;    L4 := 10;  -- lengths (world units)

    -- constant base pose and world-aligned basis (×100)
    base_px := 0; base_py := 0; base_pz := 0;
    base_xhx := 100; base_xhy := 0;   base_xhz := 0;
    base_yhx := 0;   base_yhy := 100; base_yhz := 0;
    base_zhx := 0;   base_zhy := 0;   base_zhz := 100;

    endX := seg2.px2;  
    endY := seg2.py2;  
    endZ := seg2.pz2;

--Error calculation
-- 2D CASE: y - up
    -- discretization_angle := 10;
    -- error := LEN*sin10 = 10 * 0,173 = 1,73;

    error := 1; -- +-1 (error=2) endX and endY coordinates error while checking reachability
    checkX := 0;
    checkY := 0;
    checkZ := 10;
    endX_inside_limits := (endX <= (checkX + error) & endX >= (checkX - error));
    endY_inside_limits := (endY <= (checkY + error) & endY >= (checkY - error));
    endZ_inside_limits := (endZ <= (checkZ + error) & endZ >= (checkZ - error));

ASSIGN
-- Block 1
    init(yaw1) := 0;
    init(pitch1) := 0;
    next(yaw1)   := { 
            yaw1,               -- stays the same 
            (yaw1+1) mod 36,    -- + 10 degrees
            (yaw1+35) mod 36    -- - 10 degrees
    };
    next(pitch1)   := { 
            pitch1,             -- stays the same 
            (pitch1+1) mod 36, -- + 10 degrees
            (pitch1+35) mod 36 -- - 10 degrees
    };

-- Block 2
    init(yaw2) := 0;
    init(pitch2) := 0;
    next(yaw2)   := { 
                yaw2,               -- stays the same 
                (yaw2+1) mod 36,    -- + 10 degrees
                (yaw2+35) mod 36    -- - 10 degrees
                };
    next(pitch2)   := { 
                pitch2,             -- stays the same 
                (pitch2+1) mod 36, -- + 10 degrees
                (pitch2+35) mod 36 -- - 10 degrees
    };

-- Block 3
    -- init(yaw3) := 0;
    -- init(pitch3) := 0;
    -- next(yaw3)   := { 
    --                 yaw3,               -- stays the same 
    --                 (yaw3+1) mod 36,    -- + 10 degrees
    --                 (yaw3+35) mod 36    -- - 10 degrees
    --                 };
    -- next(pitch3)   := { 
    --             pitch3,             -- stays the same 
    --             (pitch3+1) mod 36, -- + 10 degrees
    --             (pitch3+35) mod 36 -- - 10 degrees
    -- };

-- ---------- Reachability specification------------------------------------------
-- LTLSPEC 
--     G !(endX_inside_limits & endY_inside_limits & endZ_inside_limits)
CTLSPEC 
      AG !(endX_inside_limits & endY_inside_limits & endZ_inside_limits ) --& blocks_above_serface)

