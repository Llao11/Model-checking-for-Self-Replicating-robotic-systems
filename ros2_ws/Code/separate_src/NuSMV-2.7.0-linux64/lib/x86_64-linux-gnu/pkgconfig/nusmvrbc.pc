prefix=/
includedir=${prefix}/include
libdir=${prefix}/lib/x86_64-linux-gnu

with_bignumbers=true
with_compass=true
with_libxml2=true
with_ltl2smv=true
with_profiler=false
with_shell=true
with_watchdog=false

Name: nusmvrbc
Description: NuSMV RBC library
Version: 2.7.0
Requires: cudd
Libs: -L${libdir} -lnusmvrbc
Cflags: -I${includedir}
