<?xml version="1.0"?>
<robot name="box_robot">
  <!-- Fixed base box -->
  <link name="world"/>
  
  <link name="fixed_box">
    <visual>
      <geometry>
        <box size="0.5 0.5 0.5"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0 1 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.5 0.5 0.5"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.042" ixy="0.0" ixz="0.0" iyy="0.042" iyz="0.0" izz="0.042"/>
    </inertial>
  </link>

  <joint name="world_to_box" type="fixed">
    <parent link="world"/>
    <child link="fixed_box"/>
    <origin xyz="0 0 0.25"/>
  </joint>

  <!-- Movable box -->
  <link name="movable_box">
    <visual>
      <geometry>
        <box size="0.3 0.3 0.3"/>
      </geometry>
      <material name="red">
        <color rgba="1 0 0 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.3 0.3 0.3"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.0125" ixy="0.0" ixz="0.0" iyy="0.0125" iyz="0.0" izz="0.0125"/>
    </inertial>
  </link>

  <joint name="controllable_joint" type="fixed">
    <parent link="fixed_box"/>
    <child link="movable_box"/>
    <origin xyz="0 0 0.4"/>
    <axis xyz="0 0 1"/>
  </joint>
</robot>
