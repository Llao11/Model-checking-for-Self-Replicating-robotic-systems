<?xml version="1.0"?>
<sdf version="1.10">
  <model name="robot">
    <pose>0 0 0 0 0 0</pose>

    <link name="vox1">
      <pose>0 0 0 0 0 0</pose>
      <visual name="body_visual">
        <geometry>
          <mesh>
            <!-- <uri>file:///media/lao/ssdLIBRARY/BauhausUni/Masterarbeit/Simulation/ros2_ws/src/srrs_sim/stl/Voxel.stl</uri> -->
            <uri>file:///home/lao/Documents/Masterarbeit/Simulation/ros2_ws/src/srrs_sim/stl/Voxel.stl</uri>
            <scale> 0.001 0.001 0.001 </scale>
          </mesh>
        </geometry>
        <material>
          <ambient>1 0.1 0.1 1</ambient>
          <diffuse>1 0.1 0.1 1</diffuse>
        </material>
      </visual>
      <collision name="body_collision">
        <geometry>
          <mesh>
            <!-- <uri>file:///media/lao/ssdLIBRARY/BauhausUni/Masterarbeit/Simulation/ros2_ws/src/srrs_sim/stl/Voxel.stl</uri> -->
            <uri>file:///home/lao/Documents/Masterarbeit/Simulation/ros2_ws/src/srrs_sim/stl/Voxel.stl</uri>
            <scale> 0.001 0.001 0.001 </scale>
          </mesh>
        </geometry>
      </collision>
    </link>


    <link name="vox2">
      <pose>0 0 0.141 0 0 0</pose>
      <visual name="body_visual">
        <geometry>
          <mesh>
            <!-- <uri>file:///media/lao/ssdLIBRARY/BauhausUni/Masterarbeit/Simulation/ros2_ws/src/srrs_sim/stl/Voxel.stl</uri> -->
            <uri>file:///home/lao/Documents/Masterarbeit/Simulation/ros2_ws/src/srrs_sim/stl/Voxel.stl</uri>
            <scale> 0.001 0.001 0.001 </scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
      <collision name="body_collision">
        <geometry>
          <mesh>
            <!-- <uri>file:///media/lao/ssdLIBRARY/BauhausUni/Masterarbeit/Simulation/ros2_ws/src/srrs_sim/stl/Voxel.stl</uri> -->
            <uri>file:///home/lao/Documents/Masterarbeit/Simulation/ros2_ws/src/srrs_sim/stl/Voxel.stl</uri>
            <scale> 0.001 0.001 0.001 </scale>
          </mesh>
        </geometry>
      </collision>
    </link>

        <!-- Add a joint to connect the wheel to the base -->
    <joint name="revolute_joint" type="revolute">
      <parent>vox1</parent>
      <child>vox2</child>
      <pose>0 0 0.1 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-3.14</lower>
          <upper>3.14</upper>
        </limit>
      </axis>
    </joint>

    <!-- Plugins -->

    <plugin 
      filename="libgz_ros2_control-system.so" 
      name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>/home/lao/Documents/Masterarbeit/Simulation/ros2_ws/src/srrs_sim/config/controller.yaml</parameters>
    </plugin>
    
    <ros2_control name="GazeboSystem" type="system">
      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>
      <joint name="revolute_joint">
        <command_topic>/revolute_joint/command</command_topic>
      </joint>
    </ros2_control>
    
    

  </model>
</sdf>