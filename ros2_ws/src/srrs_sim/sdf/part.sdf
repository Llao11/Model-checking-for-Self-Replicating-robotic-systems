<?xml version="1.0"?>
<sdf version="1.10">
  <model name="voxel">
    <pose>0 0 0 0 0 0</pose>

    <link name="part">
      <pose>0 0 0 0 0 0</pose>
      <visual name="body_visual">
        <geometry>
          <mesh>
            <uri>file:///home/lao/Documents/Masterarbeit/git/SRRS_gazebo_sim/ros2_ws/src/srrs_sim/meshes/Voxel.stl</uri>
            <scale> 0.001 0.001 0.001 </scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.0 0.9 0.0 1</ambient>
          <diffuse>0.0 0.9 0.0 1</diffuse>
        </material>
      </visual>
      <collision name="body_collision">
        <geometry>
          <mesh>
            <uri>file:///home/lao/Documents/Masterarbeit/git/SRRS_gazebo_sim/ros2_ws/src/srrs_sim/meshes/Voxel.stl</uri>
            <scale> 0.001 0.001 0.001 </scale>
          </mesh>
        </geometry>
      </collision>
    </link>

    <plugin
      filename="libgz-sim8-detachable-joint-system.so"
      name="gz::sim::systems::DetachableJoint">
      <parent_link>part</parent_link>
      <child_model>robot</child_model>
      <child_link>block14fix</child_link>
      <attach_topic>attach_obj_link2</attach_topic>
      <detach_topic>detach_obj_link2</detach_topic>
      <output_topic>detachable_obj_link_state2</output_topic>
    </plugin>

  </model>
</sdf>