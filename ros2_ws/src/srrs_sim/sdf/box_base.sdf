<?xml version="1.0"?>
<sdf version="1.10">
  <model name="box_base">
    <pose>0 0 0 0 0 0</pose>
      <link name="base_link">
      <pose>0 0 0 0 0 0</pose>
      <visual name="body_visual">
        <geometry>
          <box> 
            <size>2 2 0.01 </size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
      </link>
      <joint name="fixed_to_world" type="fixed">
        <parent>world</parent>
        <child>base_link</child>
        <pose>0 0 0 0 0 0</pose> 
      </joint>
    </model>
</sdf>