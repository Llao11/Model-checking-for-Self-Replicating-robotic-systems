-- 3-D robot link with yaw ψ and pitch φ (10° discretisation)
-- Parameters:
--   yawVar   : VAR  0..35   ( multiples of 10°)
--   pitchVar : VAR  0..9    ( multiples of 10°)
--   LEN      : constant length
--   baseX,Y,Z: absolute parent-joint coordinates
-------------------------------------------------------------------------------

 --===== BASE BLOCK========================================
MODULE BaseBlock(LEN)

DEFINE
    x_end  := 0;
    y_end  := 0;
    z_end  := LEN;   -- vertical
    yawAbs := 0;     -- no rotation

 --===== VERTICAL ROTATING BLOCK========================================

MODULE block_rot_vert(yawVar, LEN, baseX, baseY, baseZ, parentYaw)
DEFINE
    yawAbs := (parentYaw + yawVar) mod 36;   -- absolute yaw 0..35

     --- sin & cos lookup tables (values ×100) ------------------------- 
    sinYaw := case
        yawAbs = 0  :   0;  yawAbs = 1  :  17; yawAbs = 2  :  34; yawAbs = 3  : 50;
        yawAbs = 4  :  64; yawAbs = 5  :  77; yawAbs = 6  :  87; yawAbs = 7  : 94;
        yawAbs = 8  :  98; yawAbs = 9  : 100; yawAbs = 10 :  98; yawAbs = 11 : 94;
        yawAbs = 12 :  87; yawAbs = 13 :  77; yawAbs = 14 :  64; yawAbs = 15 : 50;
        yawAbs = 16 :  34; yawAbs = 17 :  17; yawAbs = 18 :   0; yawAbs = 19 :-17;
        yawAbs = 20 :-34;  yawAbs = 21 :-50;  yawAbs = 22 :-64;  yawAbs = 23 :-77;
        yawAbs = 24 :-87;  yawAbs = 25 :-94;  yawAbs = 26 :-98;  yawAbs = 27 :-100;
        yawAbs = 28 :-98;  yawAbs = 29 :-94;  yawAbs = 30 :-87;  yawAbs = 31 :-77;
        yawAbs = 32 :-64;  yawAbs = 33 :-50;  yawAbs = 34 :-34;  yawAbs = 35 :-17;
        TRUE : 0;
    esac;

    cosYaw := case
        yawAbs = 0  : 100; yawAbs = 1  :  98; yawAbs = 2  :  94; yawAbs = 3  : 87;
        yawAbs = 4  :  77; yawAbs = 5  :  64; yawAbs = 6  :  50; yawAbs = 7  : 34;
        yawAbs = 8  :  17; yawAbs = 9  :   0; yawAbs = 10 :-17;  yawAbs = 11 :-34;
        yawAbs = 12 :-50;  yawAbs = 13 :-64;  yawAbs = 14 :-77;  yawAbs = 15 :-87;
        yawAbs = 16 :-94;  yawAbs = 17 :-98;  yawAbs = 18 :-100; yawAbs = 19 :-98;
        yawAbs = 20 :-94;  yawAbs = 21 :-87;  yawAbs = 22 :-77;  yawAbs = 23 :-64;
        yawAbs = 24 :-50;  yawAbs = 25 :-34;  yawAbs = 26 :-17;  yawAbs = 27 :   0;
        yawAbs = 28 :  17; yawAbs = 29 :  34; yawAbs = 30 :  50; yawAbs = 31 : 64;
        yawAbs = 32 :  77; yawAbs = 33 :  87; yawAbs = 34 :  94; yawAbs = 35 : 98;
        TRUE : 0;
    esac;


 --- Cartesian delta (lies in the XY-plane) ------------------------ */
    deltaX := (LEN * sinYaw) / 100;
    deltaY := (LEN * cosYaw) / 100;
    deltaZ := 0;

    x_end := baseX + deltaX;
    y_end := baseY + deltaY;
    z_end := baseZ + deltaZ;


 --===== HORIZONTAL ROTATING BLOCK========================================

MODULE block_rot_hor(pitchVar, LEN, baseX, baseY, baseZ, parentYaw)
DEFINE
-- sin and cos [0,1] => [0,100]
    sinPitch := case     
        pitchVar = 0  :   0; pitchVar = 1  : 17;  pitchVar = 2  : 34; pitchVar = 3  : 50; pitchVar = 4  : 64; pitchVar = 5  : 77;
        pitchVar = 6  : 87; pitchVar = 7  : 94; pitchVar = 8  : 98; pitchVar = 9  : 100; pitchVar = 10 : 98; pitchVar = 11 : 94;
        pitchVar = 12 : 87; pitchVar = 13 : 77; pitchVar = 14 : 64; pitchVar = 15 : 50; pitchVar = 16 : 34; pitchVar = 17 : 17;
        pitchVar = 18 :   0; pitchVar = 19 :-17; pitchVar = 20 :-34; pitchVar = 21 :-50; pitchVar = 22 :-64; pitchVar = 23 :-77;
        pitchVar = 24 :-87; pitchVar = 25 :-94; pitchVar = 26 :-98; pitchVar = 27 :-100; pitchVar = 28 :-98; pitchVar = 29 :-94;
        pitchVar = 30 :-87; pitchVar = 31 :-77; pitchVar = 32 :-64; pitchVar = 33 :-50; pitchVar = 34 :-34; pitchVar = 35 :-17;
        TRUE : 0;
    esac;

    cosPitch := case
        pitchVar = 0  : 100; pitchVar = 1  : 98;  pitchVar = 2  : 94; pitchVar = 3  : 87; pitchVar = 4  : 77; pitchVar = 5  : 64;
        pitchVar = 6  : 50; pitchVar = 7  : 34; pitchVar = 8  : 17; pitchVar = 9  :   0 ; pitchVar = 10 :-17;  pitchVar = 11 :-34;
        pitchVar = 12 :-50; pitchVar = 13 :-64; pitchVar = 14 :-77; pitchVar = 15 :-87; pitchVar = 16 :-94; pitchVar = 17 :-98;
        pitchVar = 18 :-100; pitchVar = 19 :-98; pitchVar = 20 :-94; pitchVar = 21 :-87; pitchVar = 22 :-77; pitchVar = 23 :-64;
        pitchVar = 24 :-50; pitchVar = 25 :-34; pitchVar = 26 :-17; pitchVar = 27 :   0; pitchVar = 28 : 17; pitchVar = 29 : 34;
        pitchVar = 30 : 50; pitchVar = 31 : 64; pitchVar = 32 : 77; pitchVar = 33 : 87; pitchVar = 34 : 94; pitchVar = 35 : 98;
        TRUE : 0;
    esac;

-- sin and cos [0,1] => [0,100]
    sinYaw := case
        parentYaw = 0  :   0; parentYaw = 1  : 17;  parentYaw = 2  : 34; parentYaw = 3  : 50; parentYaw = 4  : 64; parentYaw = 5  : 77;
        parentYaw = 6  : 87; parentYaw = 7  : 94; parentYaw = 8  : 98; parentYaw = 9  : 100; parentYaw = 10 : 98; parentYaw = 11 : 94;
        parentYaw = 12 : 87; parentYaw = 13 : 77; parentYaw = 14 : 64; parentYaw = 15 : 50; parentYaw = 16 : 34; parentYaw = 17 : 17;
        parentYaw = 18 :   0; parentYaw = 19 :-17; parentYaw = 20 :-34; parentYaw = 21 :-50; parentYaw = 22 :-64; parentYaw = 23 :-77;
        parentYaw = 24 :-87; parentYaw = 25 :-94; parentYaw = 26 :-98; parentYaw = 27 :-100; parentYaw = 28 :-98; parentYaw = 29 :-94;
        parentYaw = 30 :-87; parentYaw = 31 :-77; parentYaw = 32 :-64; parentYaw = 33 :-50; parentYaw = 34 :-34; parentYaw = 35 :-17;
        TRUE : 0;
    esac;

    cosYaw := case
        parentYaw = 0  : 100; parentYaw = 1  : 98;  parentYaw = 2  : 94; parentYaw = 3  : 87; parentYaw = 4  : 77; parentYaw = 5  : 64;
        parentYaw = 6  : 50; parentYaw = 7  : 34; parentYaw = 8  : 17; parentYaw = 9  :   0 ; parentYaw = 10 :-17;  parentYaw = 11 :-34;
        parentYaw = 12 :-50; parentYaw = 13 :-64; parentYaw = 14 :-77; parentYaw = 15 :-87; parentYaw = 16 :-94; parentYaw = 17 :-98;
        parentYaw = 18 :-100; parentYaw = 19 :-98; parentYaw = 20 :-94; parentYaw = 21 :-87; parentYaw = 22 :-77; parentYaw = 23 :-64;
        parentYaw = 24 :-50; parentYaw = 25 :-34; parentYaw = 26 :-17; parentYaw = 27 :   0; parentYaw = 28 : 17; parentYaw = 29 : 34;
        parentYaw = 30 : 50; parentYaw = 31 : 64; parentYaw = 32 : 77; parentYaw = 33 : 87; parentYaw = 34 : 94; parentYaw = 35 : 98;
        TRUE : 0;
    esac;


    -- ----- Cartesian deltas (integer, scaled ÷10000) -------------------- 
    deltaX := (LEN * cosPitch * cosYaw) / 10000;
    deltaY := (LEN * cosPitch * sinYaw) / 10000;
    deltaZ := (LEN * sinPitch)          / 100;

    x_end := baseX + deltaX;
    y_end := baseY + deltaY;
    z_end := baseZ + deltaZ;

    yawAbs := parentYaw;   -- this joint does not change yaw



 --===== MAIN ========================================

MODULE main

VAR
    -- joint angles (nondet. for exploration)
    yaw1 : 0..35;
    pitch2 : 0..35;   -- link2
    pitch3 : 0..35;   -- link3

    block_0 : BaseBlock(LEN);
    block_1 : block_rot_vert(yaw1, LEN, block_0.x_end, block_0.y_end, block_0.z_end, block_0.yawAbs);
    block_2 : block_rot_hor(pitch2, LEN, block_1.x_end, block_1.y_end, block_1.z_end, block_1.yawAbs);
    block_3 : block_rot_hor(pitch3, LEN, block_2.x_end, block_2.y_end, block_2.z_end, block_2.yawAbs);

DEFINE
    LEN := 10;           -- same length for all three links
    endX := block_3.x_end;
    endY := block_3.y_end;
    endZ := block_3.z_end;

    error := 2; -- endX and endY coordinates error while checking reachability
    checkX := 19;
    checkY := 10;
    checkZ := 10;
    endX_inside_limits := (endX <= (checkX + error) & endX >= (checkX - error));
    endY_inside_limits := (endY <= (checkY + error) & endY >= (checkY - error));
    endZ_inside_limits := (endZ <= (checkZ + error) & endZ >= (checkZ - error));
-- ---------- Reachability specification------------------------------------------

-- LTLSPEC 
    -- G F !(endX = 0 & endY = 0 & endZ = 9)
    -- G F !(endX_inside_limits & endY_inside_limits & endZ_inside_limits)
CTLSPEC 
     -- EF (endX = 3 & endY = 5 & endZ = 15)
     AF !(endX_inside_limits & endY_inside_limits & endZ_inside_limits)


