-- 3-D robot link with yaw and pitch (10 degrees discretisation)
-- Parameters:
--   yawVar   : VAR  0..35   ( multiples of 10°)
--   pitchVar : VAR  0..9    ( multiples of 10°)
--   LEN      : constant length
--   baseX,Y,Z: absolute parent-joint coordinates
-------------------------------------------------------------------------------

 --===== SINE Calculation========================================
MODULE sin(angle)
DEFINE
    val:= case
        angle = 0  :   0;  
        angle = 1  :  17; 
        angle = 2  :  34;
        angle = 3  : 50;
        angle = 4  :  64;
        angle = 5  :  77;
        angle = 6  :  87;
        angle = 7  : 94;
        angle = 8  :  98;
        angle = 9  : 100;
        angle = 10 :  98;
        angle = 11 : 94;
        angle = 12 :  87;
        angle = 13 :  77;
        angle = 14 :  64;
        angle = 15 : 50;
        angle = 16 :  34;
        angle = 17 :  17;
        angle = 18 :   0;
        angle = 19 :-17;
        angle = 20 :-34;
        angle = 21 :-50;
        angle = 22 :-64;
        angle = 23 :-77;
        angle = 24 :-87;
        angle = 25 :-94;
        angle = 26 :-98;
        angle = 27 :-100;
        angle = 28 :-98;
        angle = 29 :-94;
        angle = 30 :-87;
        angle = 31 :-77;
        angle = 32 :-64;
        angle = 33 :-50;
        angle = 34 :-34;
        angle = 35 :-17;
        TRUE : 0;
    esac;

 --===== COSINE Calculation========================================
MODULE cos(angle)
DEFINE
    val:= case
        angle = 0  : 100;
        angle = 1  :  98;
        angle = 2  :  94;
        angle = 3  : 87;
        angle = 4  :  77;
        angle = 5  :  64;
        angle = 6  :  50;
        angle = 7  : 34;
        angle = 8  :  17;
        angle = 9  :   0;
        angle = 10 :-17;
        angle = 11 :-34;
        angle = 12 :-50;
        angle = 13 :-64;
        angle = 14 :-77;
        angle = 15 :-87;
        angle = 16 :-94;
        angle = 17 :-98;
        angle = 18 :-100;
        angle = 19 :-98;
        angle = 20 :-94;
        angle = 21 :-87;
        angle = 22 :-77;
        angle = 23 :-64;
        angle = 24 :-50;
        angle = 25 :-34;
        angle = 26 :-17;
        angle = 27 :   0;
        angle = 28 :  17;
        angle = 29 :  34;
        angle = 30 :  50;
        angle = 31 : 64;
        angle = 32 :  77;
        angle = 33 :  87;
        angle = 34 :  94;
        angle = 35 : 98;
        TRUE : 0;
    esac;


 --===== BASE BLOCK========================================
MODULE BaseBlock(LEN,base_x,base_y,base_z)

DEFINE
    x_end  := base_x;
    y_end  := base_y;
    z_end  := LEN;   -- vertical
    yawAbs := 0;     -- no rotation

 --===== VERTICAL ROTATING BLOCK========================================

MODULE block_rot_vert(yawVar, LEN, baseX, baseY, baseZ, parentYaw)
VAR
    sin : sin(yawAbs);
    cos : cos(yawAbs);
DEFINE
    yawAbs := (parentYaw + yawVar) mod 36;   -- absolute yaw 0..35
    sinYaw := sin.val;
    cosYaw := cos.val;

 --- Cartesian delta (lies in the XY-plane) ------------------------ */
    deltaX := (LEN * sinYaw) / 100;
    deltaY := (LEN * cosYaw) / 100;
    deltaZ := 0;

    x_end := baseX + deltaX;
    y_end := baseY + deltaY;
    z_end := baseZ + deltaZ;


 --===== HORIZONTAL ROTATING BLOCK========================================

MODULE block_rot_hor(pitchVar, LEN, baseX, baseY, baseZ, parentYaw)
VAR
    sinPitchVar : sin(pitchVar);
    cosPitchVar : cos(pitchVar);
    sinYawVar : sin(parentYaw);
    cosYawVar : cos(parentYaw);
DEFINE
-- sin and cos [0,1] => [0,100]
    sinPitch := sinPitchVar.val;
    cosPitch := cosPitchVar.val;
-- sin and cos [0,1] => [0,100]
    sinYaw := sinYawVar.val;
    cosYaw := cosYawVar.val;

    -- ----- Cartesian deltas (integer, scaled ÷10000) -------------------- 
    deltaX := (LEN * cosPitch * cosYaw) / 10000;
    deltaY := (LEN * cosPitch * sinYaw) / 10000;
    deltaZ := (LEN * sinPitch)          / 100;

    x_end := baseX + deltaX;
    y_end := baseY + deltaY;
    z_end := baseZ + deltaZ;

    yawAbs := parentYaw;   -- this joint does not change yaw


 --===== MAIN ========================================
MODULE main

VAR 
    -- joint angles (nondet. for exploration)
    yaw1 : 0..35;
    pitch2 : 0..35;   -- link2
    pitch3 : 0..35;   -- link3
    pitch4 : 0..35;   -- link3
    yaw5 : 0..35;
    block_0 : BaseBlock(LEN,baseX,baseY,baseZ);
    block_1 : block_rot_vert(yaw1, LEN, block_0.x_end, block_0.y_end, block_0.z_end, block_0.yawAbs);
    block_2 : block_rot_hor(pitch2, LEN, block_1.x_end, block_1.y_end, block_1.z_end, block_1.yawAbs);
    block_3 : block_rot_hor(pitch3, LEN, block_2.x_end, block_2.y_end, block_2.z_end, block_2.yawAbs);
    block_4 : block_rot_hor(pitch4, LEN, block_3.x_end, block_3.y_end, block_3.z_end, block_3.yawAbs);
    block_5 : block_rot_vert(yaw5, LEN, block_4.x_end, block_4.y_end, block_4.z_end, block_4.yawAbs);
    -- block_6 : BaseBlock(LEN,block_5.x_end,block_5.y_end, block_5.z_end);

DEFINE
    LEN := 10;           -- same length for all three links
    baseX :=0;
    baseY :=0;
    baseZ :=0;
    endX := block_5.x_end;

    endY := block_5.y_end;
    endZ := block_5.z_end;

--Error calculation
-- 2D CASE: y - up
    -- discretization_angle := 10;
    -- error := LEN*sin10 = 10 * 0,173 = 1,73;

    error := 1; -- +-1 (error=2) endX and endY coordinates error while checking reachability
checkX := 1;
checkY := 1;
checkZ := 1;
    endX_inside_limits := (endX <= (checkX + error) & endX >= (checkX - error));
    endY_inside_limits := (endY <= (checkY + error) & endY >= (checkY - error));
    endZ_inside_limits := (endZ <= (checkZ + error) & endZ >= (checkZ - error));

ASSIGN
    init(yaw1)   := 0;
    init(pitch2) := 0;
    init(pitch3) := 0;
    init(pitch4) := 0;
    init(yaw5)   := 0;

    next(yaw1)   := { 
                    yaw1,               -- stays the same 
                    (yaw1+1) mod 36,    -- + 10 degrees
                    (yaw1+35) mod 36    -- - 10 degrees
                    };
    next(pitch2)   := { 
                    pitch2,             -- stays the same 
                    (pitch2+1) mod 36, -- + 10 degrees
                    (pitch2+35) mod 36 -- - 10 degrees
    };
    next(pitch3)   := { 
                    pitch3,             -- stays the same
                    (pitch3+1) mod 36,  -- + 10 degrees
                    (pitch3+35) mod 36  -- - 10 degrees
                    };
    next(pitch4)   := { 
                    pitch4,             -- stays the same
                    (pitch4+1) mod 36,  -- + 10 degrees
                    (pitch4+35) mod 36  -- - 10 degrees
                    };
    next(yaw5)   := { 
                    yaw5,               -- stays the same 
                    (yaw5+1) mod 36,    -- + 10 degrees
                    (yaw5+35) mod 36    -- - 10 degrees
                    };


-- ---------- Reachability specification------------------------------------------
-- LTLSPEC 
--     G F !(endX_inside_limits & endY_inside_limits & endZ_inside_limits)
CTLSPEC 
      AG !(endX_inside_limits & endY_inside_limits & endZ_inside_limits)


