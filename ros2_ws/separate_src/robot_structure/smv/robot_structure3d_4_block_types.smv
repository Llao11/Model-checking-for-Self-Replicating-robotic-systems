-- 3-D robot link with yaw and pitch (10 degrees discretisation)
-- Parameters:
--   yawVar   : VAR  0..35   ( multiples of 10°)
--   pitchVar : VAR  0..35    ( multiples of 10°)
--   LEN      : constant length
--   baseX,Y,Z: absolute parent-joint coordinates
-------------------------------------------------------------------------------

 --===== SINE Calculation========================================
MODULE sin(angle)
DEFINE
    val:= case
        angle = 0  :   0;  
        angle = 1  :  17; 
        angle = 2  :  34;
        angle = 3  : 50;
        angle = 4  :  64;
        angle = 5  :  77;
        angle = 6  :  87;
        angle = 7  : 94;
        angle = 8  :  98;
        angle = 9  : 100;
        angle = 10 :  98;
        angle = 11 : 94;
        angle = 12 :  87;
        angle = 13 :  77;
        angle = 14 :  64;
        angle = 15 : 50;
        angle = 16 :  34;
        angle = 17 :  17;
        angle = 18 :   0;
        angle = 19 :-17;
        angle = 20 :-34;
        angle = 21 :-50;
        angle = 22 :-64;
        angle = 23 :-77;
        angle = 24 :-87;
        angle = 25 :-94;
        angle = 26 :-98;
        angle = 27 :-100;
        angle = 28 :-98;
        angle = 29 :-94;
        angle = 30 :-87;
        angle = 31 :-77;
        angle = 32 :-64;
        angle = 33 :-50;
        angle = 34 :-34;
        angle = 35 :-17;
        TRUE : 0;
    esac;

 --===== COSINE Calculation========================================
MODULE cos(angle)
DEFINE
    val:= case
        angle = 0  : 100;
        angle = 1  :  98;
        angle = 2  :  94;
        angle = 3  : 87;
        angle = 4  :  77;
        angle = 5  :  64;
        angle = 6  :  50;
        angle = 7  : 34;
        angle = 8  :  17;
        angle = 9  :   0;
        angle = 10 :-17;
        angle = 11 :-34;
        angle = 12 :-50;
        angle = 13 :-64;
        angle = 14 :-77;
        angle = 15 :-87;
        angle = 16 :-94;
        angle = 17 :-98;
        angle = 18 :-100;
        angle = 19 :-98;
        angle = 20 :-94;
        angle = 21 :-87;
        angle = 22 :-77;
        angle = 23 :-64;
        angle = 24 :-50;
        angle = 25 :-34;
        angle = 26 :-17;
        angle = 27 :   0;
        angle = 28 :  17;
        angle = 29 :  34;
        angle = 30 :  50;
        angle = 31 : 64;
        angle = 32 :  77;
        angle = 33 :  87;
        angle = 34 :  94;
        angle = 35 : 98;
        TRUE : 0;
    esac;


--=========================================
MODULE segment_yaw(px, py, pz,
                   xhx, xhy, xhz, yhx, yhy, yhz, zhx, zhy, zhz,
                   L, initYaw)

VAR
  yaw : 0..35;
  cy : cos(yaw);
  sy : sin(yaw);

DEFINE
  SCALE := 100;

  cos_yaw := cy.val;    -- [-100..100]
  sin_yaw := sy.val;

  -- yaw about local ẑ: rotate x/y components within each basis vector; z components unchanged
  xhx2 := (xhx * cos_yaw - xhy * sin_yaw) / SCALE;
  xhy2 := (xhx * sin_yaw + xhy * cos_yaw) / SCALE;
  xhz2 := xhz;

  yhx2 := (yhx * cos_yaw - yhy * sin_yaw) / SCALE;
  yhy2 := (yhx * sin_yaw + yhy * cos_yaw) / SCALE;
  yhz2 := yhz;

  zhx2 := zhx;
  zhy2 := zhy;
  zhz2 := zhz;

  -- advance along (updated) local ẑ
  px2 := px + (zhx2 * L) / SCALE;
  py2 := py + (zhy2 * L) / SCALE;
  pz2 := pz + (zhz2 * L) / SCALE;


ASSIGN
  init(yaw) := initYaw;
  next(yaw) := { yaw, (yaw+1) mod 36, (yaw+35) mod 36 };



--=========================================
MODULE segment_pitch(px, py, pz,
                     xhx, xhy, xhz, yhx, yhy, yhz, zhx, zhy, zhz,
                     L, initPitch)
VAR
  pitch : 0..35;

  cp : cos(pitch);
  sp : sin(pitch);

DEFINE
  SCALE := 100;

  cos_p := cp.val;    -- [-100..100]
  sin_p := sp.val;

  -- x' =  cos*p * x + sin*p * z
  -- y' =  y
  -- z' = -sin*p * x + cos*p * z
  xhx2 := (xhx * cos_p + zhx * sin_p) / SCALE;
  xhy2 := (xhy * cos_p + zhy * sin_p) / SCALE;
  xhz2 := (xhz * cos_p + zhz * sin_p) / SCALE;

  yhx2 := yhx;  yhy2 := yhy;  yhz2 := yhz;

  zhx2 := (-xhx * sin_p + zhx * cos_p) / SCALE;
  zhy2 := (-xhy * sin_p + zhy * cos_p) / SCALE;
  zhz2 := (-xhz * sin_p + zhz * cos_p) / SCALE;

  px2 := px + (zhx2 * L) / SCALE;
  py2 := py + (zhy2 * L) / SCALE;
  pz2 := pz + (zhz2 * L) / SCALE;

ASSIGN
  init(pitch) := initPitch;
  next(pitch) := { pitch, (pitch+1) mod 36, (pitch+35) mod 36 };


--========================================
MODULE main
VAR
    -- joint angles (nondet. for exploration)
    
    seg1 : segment_yaw(base_px, base_py, base_pz,
                        base_xhx, base_xhy, base_xhz,
                        base_yhx, base_yhy, base_yhz,
                        base_zhx, base_zhy, base_zhz,
                        L1, yaw1 );

    seg2 : segment_pitch(seg1.px2, seg1.py2, seg1.pz2,
                      seg1.xhx2, seg1.xhy2, seg1.xhz2,
                      seg1.yhx2, seg1.yhy2, seg1.yhz2,
                      seg1.zhx2, seg1.zhy2, seg1.zhz2,
                      L2, pitch2);
    seg3 : segment_pitch(seg2.px2, seg2.py2, seg2.pz2,
                      seg2.xhx2, seg2.xhy2, seg2.xhz2,
                      seg2.yhx2, seg2.yhy2, seg2.yhz2,
                      seg2.zhx2, seg2.zhy2, seg2.zhz2,
                      L3, pitch3);
    seg4 : segment_yaw(seg3.px, seg3.py, seg3.pz,
                        seg3.xhx, seg3.xhy, seg3.xhz,
                        seg3.yhx, seg3.yhy, seg3.yhz,
                        seg3.zhx, seg3.zhy, seg3.zhz,
                        L4, yaw4 );

    seg5 : segment_pitch(seg4.px2, seg4.py2, seg4.pz2,
                      seg4.xhx2, seg4.xhy2, seg4.xhz2,
                      seg4.yhx2, seg4.yhy2, seg4.yhz2,
                      seg4.zhx2, seg4.zhy2, seg4.zhz2,
                      L3, pitch5);
DEFINE
    -- POS_MAX := 100;
    L1 := 10;   L2 := 10;    L3 := 10;    L4 := 10;  -- lengths (world units)
-- link1
    yaw1    := 0;
-- link2
    pitch2  := 0;
-- link3
    pitch3  := 0;   
-- link4
    yaw4    := 0;
-- link5
    pitch5  := 0;

    -- constant base pose and world-aligned basis (×100)
    base_px := 0;       base_py := 0;       base_pz := 0;

    base_xhx := 100;    base_xhy := 0;      base_xhz := 0;
    base_yhx := 0;      base_yhy := 100;    base_yhz := 0;
    base_zhx := 0;      base_zhy := 0;      base_zhz := 100;

    endX := seg5.px2;  
    endY := seg5.py2;  
    endZ := seg5.pz2;

--Error calculation
-- 2D CASE: y - up
    -- discretization_angle := 10;
    -- error := LEN*sin10 = 10 * 0,173 = 1,73;

    error := 1; -- +-1 (error=2) endX and endY coordinates error while checking reachability
    checkX := 0;
    checkY := 0;
    checkZ := 30;
    endX_inside_limits := (endX <= (checkX + error) & endX >= (checkX - error));
    endY_inside_limits := (endY <= (checkY + error) & endY >= (checkY - error));
    endZ_inside_limits := (endZ <= (checkZ + error) & endZ >= (checkZ - error));

-- ---------- Reachability specification------------------------------------------
-- LTLSPEC 
--     G F !(endX_inside_limits & endY_inside_limits & endZ_inside_limits)
CTLSPEC 
      AG !(endX_inside_limits & endY_inside_limits & endZ_inside_limits ) --& blocks_above_serface)


