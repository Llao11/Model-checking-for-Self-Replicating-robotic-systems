-- 3-D robot link with yaw and pitch (10 degrees discretisation)
-- Parameters:
--   yawVar   : VAR  0..35   ( multiples of 10°)
--   pitchVar : VAR  0..35    ( multiples of 10°)
--   LEN      : constant length
--   baseX,Y,Z: absolute parent-joint coordinates
-------------------------------------------------------------------------------

 --===== SINE Calculation========================================
MODULE sin(angle)
    DEFINE
    val:= case
    angle = -17 : -17;
    angle = -16 : -34;
    angle = -15 : -50;
    angle = -14 : -64;
    angle = -13 : -77;
    angle = -12 : -87;
    angle = -11 : -94;
    angle = -10 : -98;
    angle =  -9 : -100;
    angle =  -8 : -98;
    angle =  -7 : -94;
    angle =  -6 : -87;
    angle =  -5 : -77;
    angle =  -4 : -64;
    angle =  -3 : -50;
    angle =  -2 : -34;
    angle =  -1 : -17;
    angle =   0 :   0;
    angle =   1 :  17;
    angle =   2 :  34;
    angle =   3 :  50;
    angle =   4 :  64;
    angle =   5 :  77;
    angle =   6 :  87;
    angle =   7 :  94;
    angle =   8 :  98;
    angle =   9 : 100;
    angle =  10 :  98;
    angle =  11 :  94;
    angle =  12 :  87;
    angle =  13 :  77;
    angle =  14 :  64;
    angle =  15 :  50;
    angle =  16 :  34;
    angle =  17 :  17;
    angle =  18 :   0;
TRUE : 0;
esac;

    --===== COSINE Calculation========================================
MODULE cos(angle)
    DEFINE
    val:= case
    angle = -17 :  -98;
    angle = -16 :  -94;
    angle = -15 :  -87;
    angle = -14 :  -77;
    angle = -13 :  -64;
    angle = -12 :  -50;
    angle = -11 :  -34;
    angle = -10 :  -17;
    angle =  -9 :    0;
    angle =  -8 :   17;
    angle =  -7 :   34;
    angle =  -6 :   50;
    angle =  -5 :   64;
    angle =  -4 :   77;
    angle =  -3 :   87;
    angle =  -2 :   94;
    angle =  -1 :   98;
    angle =   0 :  100;
    angle =   1 :   98;
    angle =   2 :   94;
    angle =   3 :   87;
    angle =   4 :   77;
    angle =   5 :   64;
    angle =   6 :   50;
    angle =   7 :   34;
    angle =   8 :   17;
    angle =   9 :    0;
    angle =  10 :  -17;
    angle =  11 :  -34;
    angle =  12 :  -50;
    angle =  13 :  -64;
    angle =  14 :  -77;
    angle =  15 :  -87;
    angle =  16 :  -94;
    angle =  17 :  -98;
    angle =  18 : -100;
TRUE : 0;
esac;

    --=========================================
MODULE block_base(px, py, pz, xhx, xhy, xhz, yhx, yhy, yhz, zhx, zhy, zhz, L)
    DEFINE
    xhx2 := xhx;
xhy2 := xhx;
xhz2 := xhz;

yhx2 := yhx;
yhy2 := yhx;
yhz2 := yhz;

zhx2 := zhx;
zhy2 := zhy;
zhz2 := zhz;

-- advance along (updated) local ẑ
px2 := px;
py2 := py;
pz2 := pz;

    --=========================================
MODULE block_yaw(px, py, pz,
        xhx, xhy, xhz, yhx, yhy, yhz, zhx, zhy, zhz,
        L, initYaw)
    VAR
    yaw : -17..18;
cy : cos(yaw);
sy : sin(yaw);

DEFINE
SCALE := 100;

cos_yaw := cy.val;    -- [-100..100]
sin_yaw := sy.val;

-- yaw about local ẑ: rotate x/y components within each basis vector; z components unchanged
xhx2 := (xhx * cos_yaw - xhy * sin_yaw) / SCALE;
xhy2 := (xhx * sin_yaw + xhy * cos_yaw) / SCALE;
xhz2 := xhz;

yhx2 := (yhx * cos_yaw - yhy * sin_yaw) / SCALE;
yhy2 := (yhx * sin_yaw + yhy * cos_yaw) / SCALE;
yhz2 := yhz;

zhx2 := zhx;
zhy2 := zhy;
zhz2 := zhz;

-- advance along (updated) local ẑ
px2 := px + (zhx2 * L) / SCALE;
py2 := py + (zhy2 * L) / SCALE;
pz2 := pz + (zhz2 * L) / SCALE;


ASSIGN
init(yaw) := initYaw;
next(yaw) := case 
             yaw = -17: {yaw, (yaw + 1)};
yaw = 18: {yaw, (yaw - 1)};
TRUE: { yaw, (yaw + 1), (yaw - 1)  };
esac;



    --=========================================
MODULE block_pitch(px, py, pz,
        xhx, xhy, xhz, yhx, yhy, yhz, zhx, zhy, zhz,
        L, initPitch)
    VAR
    pitch : -17..18;

cp : cos(pitch);
sp : sin(pitch);

DEFINE
SCALE := 100;

cos_p := cp.val;    -- [-100..100]
sin_p := sp.val;

-- x' =  cos*p * x + sin*p * z
-- y' =  y
-- z' = -sin*p * x + cos*p * z
xhx2 := (xhx * cos_p + zhx * sin_p) / SCALE;
xhy2 := (xhy * cos_p + zhy * sin_p) / SCALE;
xhz2 := (xhz * cos_p + zhz * sin_p) / SCALE;

yhx2 := yhx;  yhy2 := yhy;  yhz2 := yhz;

zhx2 := (-xhx * sin_p + zhx * cos_p) / SCALE;
zhy2 := (-xhy * sin_p + zhy * cos_p) / SCALE;
zhz2 := (-xhz * sin_p + zhz * cos_p) / SCALE;

px2 := px + (zhx2 * L) / SCALE;
py2 := py + (zhy2 * L) / SCALE;
pz2 := pz + (zhz2 * L) / SCALE;

ASSIGN
init(pitch) := initPitch;
next(pitch) := case 
               pitch = -17: {pitch, (pitch + 1)};
pitch = 18: {pitch, (pitch - 1)};
TRUE: { pitch, (pitch + 1), (pitch - 1)  };
esac;

--========================================
MODULE block_general(type,px, py, pz,
                     xhx, xhy, xhz, yhx, yhy, yhz, zhx, zhy, zhz,
                     L, angle)
VAR
    block_y : block_yaw( px, py, pz,
                        xhx, xhy, xhz,
                        yhx, yhy, yhz,
                        zhx, zhy, zhz,
                        L, angle );

    block_p : block_pitch(px, py, pz,
                          xhx, xhy, xhz,
                          yhx, yhy, yhz,
                          zhx, zhy, zhz,
                          L, angle );
DEFINE

    -- block  :=case type=0: block_y.px2; TRUE : block_p.px2; esac;
    xhx2   :=case type=0: block_y.xhx2; TRUE : block_p.xhx2; esac;
    xhy2   :=case type=0: block_y.xhy2; TRUE : block_p.xhy2; esac;
    xhz2   :=case type=0: block_y.xhz2; TRUE : block_p.xhz2; esac;
    yhx2   :=case type=0: block_y.yhx2; TRUE : block_p.yhx2; esac;
    yhy2   :=case type=0: block_y.yhy2; TRUE : block_p.yhy2; esac;
    yhz2   :=case type=0: block_y.yhz2; TRUE : block_p.yhz2; esac;
    zhx2   :=case type=0: block_y.zhx2; TRUE : block_p.zhx2; esac;
    zhy2   :=case type=0: block_y.zhy2; TRUE : block_p.zhy2; esac;
    zhz2   :=case type=0: block_y.zhz2; TRUE : block_p.zhz2; esac;
    px2    :=case type=0: block_y.px2;  TRUE : block_p.px2;  esac;
    py2    :=case type=0: block_y.py2;  TRUE : block_p.py2;  esac;
    pz2    :=case type=0: block_y.pz2;  TRUE : block_p.pz2;  esac;



--========================================
MODULE main

FROZENVAR
        -- checkX : -10..10;
        -- checkY : -10..10;
        -- checkZ : 0..10;
    -- block2 : block_pitch(block1.px2, block1.py2, block1.pz2,
    --                  block1.xhx2, block1.xhy2, block1.xhz2,
    --                  block1.yhx2, block1.yhy2, block1.yhz2,
    --                  block1.zhx2, block1.zhy2, block1.zhz2,
    var_block1 : {0,1};
    var_block2 : {0,1};
    var_block3 : {0,1};
    -- var_block4 : {0,1};
    -- var_block5 : {0,1};
    --                  L2, pitch2);
VAR
    -- joint angles (nondet. for exploration)
    
    block0 : block_base(base_px, base_py, base_pz,
                        base_xhx, base_xhy, base_xhz,
                        base_yhx, base_yhy, base_yhz,
                        base_zhx, base_zhy, base_zhz, L0);
    block1 : block_general(var_block1, block0.px2, block0.py2, block0.pz2,
                        block0.xhx2, block0.xhy2, block0.xhz2,
                        block0.yhx2, block0.yhy2, block0.yhz2,
                        block0.zhx2, block0.zhy2, block0.zhz2, L1, angle1 );
    block2 : block_general(var_block2, block1.px2, block1.py2, block1.pz2,
                        block1.xhx2, block1.xhy2, block1.xhz2,
                        block1.yhx2, block1.yhy2, block1.yhz2,
                        block1.zhx2, block1.zhy2, block1.zhz2, L2, angle2 );
    block3 : block_general(var_block3, block2.px2, block2.py2, block2.pz2,
                        block2.xhx2, block2.xhy2, block2.xhz2,
                        block2.yhx2, block2.yhy2, block2.yhz2,
                        block2.zhx2, block2.zhy2, block2.zhz2, L3, angle3 );
    -- block4 : block_general(var_block4, block3.px2, block3.py2, block3.pz2,
    --                     block3.xhx2, block3.xhy2, block3.xhz2,
    --                     block3.yhx2, block3.yhy2, block3.yhz2,
    --                     block3.zhx2, block3.zhy2, block3.zhz2, L4, angle4 );
    -- block5 : block_general(var_block5, block3.px2, block3.py2, block3.pz2,
    --                     block3.xhx2, block3.xhy2, block3.xhz2,
    --                     block3.yhx2, block3.yhy2, block3.yhz2,
    --                     block3.zhx2, block3.zhy2, block3.zhz2, L5, angle5 );

DEFINE

-- link0
    L0 := 10;   
-- link1
    L1 := 10;   
    angle1    := 0;
-- link2
    L2 := 10;   
    angle2    := 0;
-- link3
    L3 := 10;   
    angle3    := 0;
-- link4
    L4 := 10;   
    angle4    := 0;
-- link5
    L5 := 10;   
    angle5    := 0;

    -- constant base pose and world-aligned basis (×100)
    base_px := 0;       base_py := 0;       base_pz := 0;

    base_xhx := 100;    base_xhy := 0;      base_xhz := 0;
    base_yhx := 0;      base_yhy := 100;    base_yhz := 0;
    base_zhx := 0;      base_zhy := 0;      base_zhz := 100;

    checkX := 5;
    checkY := 5;
    checkZ := 10;

    endX := block3.px2;  
    endY := block3.py2;  
    endZ := block3.pz2;

    -- blocks_above_serface := ( 
    -- block0.pz2>=0 & 
    -- block1.pz2>=0 & 
    -- block2.pz2>=0 & 
    -- block3.pz2>=0 & 
    -- block4.pz2>=0 
    -- );

--Error calculation
-- 2D CASE: y - up
    -- discretization_angle := 10;
    -- error := LEN*sin10 = 10 * 0,173 = 1,73;

    error := 1; -- +-1 (error=2) endX and endY coordinates error while checking reachability
    endX_inside_limits := (endX <= (checkX + error) & endX >= (checkX - error));
    endY_inside_limits := (endY <= (checkY + error) & endY >= (checkY - error));
    endZ_inside_limits := (endZ <= (checkZ + error) & endZ >= (checkZ - error));

-- ASSIGN
--   init(block1) := block1_yaw;
--   next(block1) := case 
--     var_block1=0 : block1_yaw;
--     var_block1=1 : block1_pitch;
--     esac;
--main end
-- ---------- Reachability specification------------------------------------------
-- LTLSPEC 
--     F (endX_inside_limits & endY_inside_limits & endZ_inside_limits)
-- CTLSPEC 
--       EF (endX_inside_limits & endY_inside_limits & endZ_inside_limits ) --& blocks_above_serface)

-- LTLSPEC 
--     G !(endX_inside_limits & endY_inside_limits & endZ_inside_limits)

CTLSPEC 
      AG !( endX_inside_limits & endY_inside_limits & endZ_inside_limits ) -- & blocks_above_serface)

