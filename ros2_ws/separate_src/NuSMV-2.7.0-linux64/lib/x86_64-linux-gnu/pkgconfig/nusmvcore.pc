prefix=/
includedir=${prefix}/include
libdir=${prefix}/lib/x86_64-linux-gnu

with_bignumbers=true
with_compass=true
with_libxml2=true
with_ltl2smv=true
with_profiler=false
with_shell=true
with_watchdog=false

Name: nusmvcore
Description: NuSMV core library
Version: 2.7.0
Requires: cudd, minisat, gmp, libxml-2.0
Libs: -L${libdir} -lnusmvcore
Cflags: -I${includedir}
